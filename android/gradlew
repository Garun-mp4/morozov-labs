#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=9.3.1
WRAPPER_HOME="$SCRIPT_DIR/.gradle-wrapper"
GRADLE_HOME="$WRAPPER_HOME/gradle-$GRADLE_VERSION"
ZIP="$WRAPPER_HOME/gradle-$GRADLE_VERSION-bin.zip"
URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$WRAPPER_HOME"
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$URL" -o "$ZIP"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP" "$URL"
  else
    echo "curl or wget is required to bootstrap Gradle." >&2
    exit 1
  fi
  unzip -q -o "$ZIP" -d "$WRAPPER_HOME"
  rm -f "$ZIP"
fi
exec "$GRADLE_HOME/bin/gradle" "$@"
